# Copie para .env.local. Na VERCEL nao precisa: a integracao Supabase<->Vercel
# cria as variaveis sozinha (Settings -> Environment Variables).
#
# O app aceita os DOIS nomes da chave publica (mesma chave, nomes de epocas
# diferentes): NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (novo, o que a integracao
# injeta) ou NEXT_PUBLIC_SUPABASE_ANON_KEY (antigo). Basta UM deles.
#
# A chave e PUBLICA por design (painel Supabase -> Settings -> API Keys).
# A secret/service_role NUNCA entra aqui nem em variavel NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://idswehsvvqczzkiatuzu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
